ErrorDocument 404 /404.html

# Revalidate HTML after deployments so cached pages do not reference removed assets.
<FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
    ExpiresActive Off
</FilesMatch>

# This announcement was removed from the site; it has no replacement.
RedirectMatch 410 ^/(?:guias|blog)/en-agosto-no-cerramos/?$

